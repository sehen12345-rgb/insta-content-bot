# ============================================================
# insta-content-bot 환경 변수 설정 예시
# 이 파일을 복사하여 .env 로 저장 후 실제 값을 입력하세요.
# ============================================================

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Reddit API (https://www.reddit.com/prefs/apps 에서 발급)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=insta-content-bot/1.0 (by u/your_username)

# Telegram Bot (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=1234567890:ABCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=your_chat_id_or_channel_id

# ElevenLabs TTS API (https://elevenlabs.io 에서 발급)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Pexels API (https://www.pexels.com/api 에서 발급)
PEXELS_API_KEY=your_pexels_api_key

# TTS 제공자 선택: elevenlabs 또는 gtts
TTS_PROVIDER=gtts

# 데모 모드: true 설정 시 실제 API 호출 없이 더미 데이터로 파이프라인 테스트
DEMO_MODE=false
